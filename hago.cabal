cabal-version:   3.0
name:            hago
version:         0.1.0.0
synopsis:        Haskell 98 syntax, strict by default, compiled to Go
license:         MIT
license-file:    LICENSE
author:          Federico Sawady
build-type:      Simple
extra-source-files:
  prelude/Prelude.hgo
  lib/**/*.hgo
  runtime/*.go

common comun
  default-language: Haskell2010
  ghc-options:      -Wall
  build-depends:    base >=4.18 && <5

library
  import:          comun
  hs-source-dirs:  src
  exposed-modules: Hago.Syntax, Hago.Lexer, Hago.Parser, Hago.Core, Hago.TcMonad, Hago.Typecheck, Hago.Derive, Hago.Expand, Hago.Specialize, Hago.Newtype, Hago.Inline, Hago.Lift, Hago.Rename,
                   Hago.CodeGen, Hago.Embed, Hago.Cache, Hago.Driver, Hago.Repl, Hago.Exhaustive, Hago.Sink, Hago.Doc, Hago.Format
  build-depends:   binary, containers, directory, filepath, mtl, parsec, process, template-haskell

executable hago
  import:          comun
  hs-source-dirs:  app
  main-is:         Main.hs
  build-depends:   hago, directory, filepath, process
