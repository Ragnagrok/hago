-- Strict by default. The tail of a list is lazy, so infinite lists work.

ones :: [Int]
ones = 1 : ones

fibs :: [Int]
fibs = 0 : 1 : zipWith (+) fibs (drop 1 fibs)

primes :: [Int]
primes = sieve [2..]
  where
    sieve (p:xs) = p : sieve (filter (\x -> x `mod` p /= 0) xs)
    sieve [] = []

-- A Lazy parameter is only evaluated if the function uses it.
unless' :: Bool -> Lazy Int -> Int
unless' True _ = 0
unless' False x = x

firstOf :: [Int] -> Int
firstOf (x:_) = x
firstOf [] = 0

firstTwo :: [Int] -> (Int, Int)
firstTwo (x:y:_) = (x, y)
firstTwo _ = (0, 0)

main :: IO ()
main = do
  print (take 5 (repeat 1))
  print (take 3 ones)
  print (take 10 fibs)
  print (take 10 primes)
  print (takeWhile (< 30) (map (* 2) [1..]))
  print (foldr (\x rest -> x > 10 || rest) False [1..])
  print (False && error "never evaluated")
  print (unless' True (error "never evaluated"))
  print (take 7 (cycle [1, 2, 3]))
  -- f $ x is f x, so x is still not evaluated
  print (unless' True $ error "never evaluated")
  -- where a plain function is expected, a Lazy parameter is just a parameter
  print (liftA2 (:) (Just 1) (Just [2, 3]))
  print (foldr (+) 0 [1, 2, 3])
  print (foldr id 0 [(+ 1), (* 2)])
  print (map (False &&) [True, False])
  -- ++ demands neither its second list nor the rest of its first
  print (firstOf ([1] ++ error "never evaluated"))
  print (firstTwo ((1 : 2 : error "never evaluated") ++ [3]))
  print (take 4 ([1] ++ ones))
  print (take 4 (ones ++ [2]))
  let one = [7]
  print (take 3 (one ++ one ++ one ++ ones), length one)
  print (take 6 (concatMap (\x -> [x]) [1 ..]))
  -- a comprehension kept as a list computes an element when it is reached
  let big = [x * 2 | x <- [1 ..], x `mod` 3 == 0]
  print (firstOf big, take 4 big)
  print (firstTwo [y | y <- 1 : 2 : 3 : error "never evaluated", y > 1])
  print (take 5 [(x, c) | x <- [1 ..], c <- [10, 20]])
  print ([a | Just a <- [Nothing, Just 1, Nothing, Just 2]], [() | False], length [i | i <- [1 .. 10], even i])
