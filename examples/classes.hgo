-- Type classes: your own classes with superclasses and defaults, instances
-- with contexts, deriving, overloaded numbers and Double.

class Show a => Shape a where
  area :: a -> Double
  name :: a -> String
  name x = show x

data Circle = Circle Double deriving (Show)
data Square = Square Double deriving (Show)

instance Shape Circle where
  area (Circle r) = 3.14159 * r * r

instance Shape Square where
  area (Square s) = s * s
  name _ = "a square"

-- A constrained function: works for any Shape, through its dictionary.
describe :: Shape a => a -> String
describe s = name s ++ " has area " ++ show (area s)

-- A Num instance of your own: literals and + work on it.
data V2 = V2 Int Int deriving (Eq, Ord, Show)

instance Num V2 where
  V2 a b + V2 c d = V2 (a + c) (b + d)
  V2 a b * V2 c d = V2 (a * c) (b * d)
  negate (V2 a b) = V2 (negate a) (negate b)
  abs (V2 a b) = V2 (abs a) (abs b)
  signum (V2 a b) = V2 (signum a) (signum b)
  fromInteger n = V2 n n

-- Derived instances on a parameterised type need the parameter's instance.
data Pair a = Pair a a deriving (Eq, Ord, Show)

-- An instance with a context: a pair of shapes is a shape.
instance Shape a => Shape (Pair a) where
  area (Pair x y) = area x + area y

class Container f where
  size :: f -> Int

instance Container [a] where
  size xs = length xs

average :: [Double] -> Double
average xs = sum xs / fromIntegral (length xs)

squares :: Num a => [a] -> [a]
squares xs = map (\x -> x * x) xs

main :: IO ()
main = do
  putStrLn (describe (Circle 1.0))
  putStrLn (describe (Square 2.5))
  putStrLn (describe (Pair (Square 1.0) (Square 2.0)))
  print (V2 1 2 + 10)
  print (sum [V2 1 1, V2 2 3, V2 (-4) 0])
  print (Pair 1 2 < Pair 1 3, Pair "b" "a" == Pair "b" "a")
  print (maximum [Pair 3 1, Pair 2 9, Pair 3 4])
  print (Just (Pair (-1.5) 2.0))
  print (average [1.0, 2.0, 4.5])
  print (squares [1, 2, 3], squares [0.5, 1.5])
  print (size (unpack "hello"), size [True, False])
  print (compare (Left 1 :: Either Int String) (Right "x"), max EQ GT)
  print (7 `div` 2, (-7) `mod` 3, 7 / 2)
  print (fromIntegral (3 :: Int) * 1.5)
