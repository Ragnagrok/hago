-- A list made only to be folded is never made: sum, length, any, mapM_ and
-- the other folds of a range, a map, a filter, a comprehension, take or
-- iterate become Go loops. These check that the loops compute what the
-- lists would, stop where they would, and compute nothing more.
import Control.Monad (forM_)
import Control.Monad.State
import qualified Data.Iter as Iter

main :: IO ()
main = do
  -- ranges: steps, empty ones, the ends of Int
  print (sum [1, 3 .. 99], sum [10, 8 .. 1], length [5 .. 1])
  print (length [maxBound - 2 ..], length [minBound + 2, minBound + 1 ..])
  print (sum (take 3 [5, 5 ..]))
  -- infinite lists, cut by take, takeWhile, or a fold that stops
  print (sum (take 5 [1 ..]), sum (takeWhile (< 10) (map (* 2) [1 ..])), sum (take 0 [1 ..]))
  print (any (> 10) [1 ..], elem 7 [1 ..], all (< 5) [1 ..], and (map (< 10) [1 ..]), or [])
  print (find (\x -> x * x > 50) [1 ..])
  -- the step after the last element taken is never computed
  print (sum (take 5 (iterate (\x -> if x > 3 then error "too far" else x + 1) 0)))
  print (sum (take 3 (repeat 7)), sum (replicate 4 5))
  -- comprehensions: guards, let, generators that depend on each other
  print (sum [x * y | x <- [1 .. 4], let y = x + 1, odd y])
  print (length [(a, b, c) | c <- [1 .. 50], b <- [1 .. c], a <- [1 .. b], a * a + b * b == c * c])
  print (sum [sum [y | y <- [1 .. x]] | x <- [1 .. 4]])
  print (sum (map fst (take 3 [(x, y) | x <- [1 ..], y <- [1 .. x]])))
  print (length (concatMap (\x -> [x, x]) [1 .. 5]))
  print (sum ([1, 2] ++ [x | x <- [10 .. 12]] ++ (if length [1, 2] > 1 then [100] else [])))
  print (maximum [x * (10 - x) | x <- [0 .. 10]], minimum (filter (> 100) [1 .. 10]))
  -- a name of the code around, bound again by the comprehension
  let x = 100
  print (foldl (\acc y -> acc + y + x) 0 [x | x <- [1 .. 3]])
  -- actions
  forM_ [1 .. 3] $ \i -> do
    let j = i * i
    print j
  mapM_ print (filter odd [1 .. 7])
  forM_ [1, 2] $ \i -> forM_ [i .. 2] $ \j -> print (i, j)
  -- actions of a monad that passes a state: the state in a variable
  n <- execStateT (forM_ [1 .. 5] $ \i -> do
    s <- get
    lift (print (i, s))
    when (even i) (put (s + i))) 100
  print n
  -- zip and zipWith: one list visited by loops, the other a step at a time
  let ws = [10, 20, 30]
  print (sum (zipWith (*) [1 ..] ws), sum (zipWith (*) ws [1 ..]))
  print (sum (map fst (zip [1 .. 5] (filter even [1 ..]))), sum (map snd (zip (filter even [1 ..]) [1 .. 5])))
  print (length (zip [1 .. 3] [1 .. 10]), length (zip [1 .. 10] (unpack "abc")))
  -- an empty first list never reaches the second's elements
  print (length (zip ([] :: [Int]) (map (\d -> 1 `div` d) [0 ..])))
  print (sum (zipWith (+) (iterate (* 2) 1) [1 .. 10]), sum (zipWith (*) (repeat 3) [1 .. 4]))
  print (sum (take 3 (zipWith (\a b -> if b > 3 then error "too far" else a + b) [10, 20 ..] (iterate (+ 1) 1))))
  forM_ (zip [1 ..] ["one", "two"]) $ \(i, w) -> putStrLn (show i ++ " " ++ w)
  print (and (zipWith (<=) [1, 2, 3, 5, 4] [2, 3, 4, 5, 6]), or (zipWith (>) [1 .. 5] [5, 4 .. 1]))
  print (sum [a * b | (a, b) <- zip [1 .. 3] [4 .. 6]])
  -- an Iter made by a do is one Go function with the loops; a fold or a
  -- mapM_ of an Iter made right there is the loops
  let triples n = do
        c <- Iter.range 1 n
        b <- Iter.range 1 c
        a <- Iter.range 1 b
        guard (a * a + b * b == c * c)
        pure (a, b, c)
  print (Iter.length (triples 30), Iter.length (triples 30) == length [() | c <- [1 .. 30], b <- [1 .. c], a <- [1 .. b], a * a + b * b == c * c])
  print (Iter.sum (Iter.take 4 (do
    x <- Iter.from 1
    guard (odd x)
    pure (x * x))))
  Iter.mapM_ print (do
    x <- Iter.range 1 3
    y <- Iter.fromList [x, x * 10]
    pure (x + y))
  print (Iter.maximum (Iter.filter even (Iter.fromList [3, 8, 1, 6])), Iter.foldl (+) 0 (Iter.append (Iter.range 1 3) (Iter.singleton 10)))
  -- a step of foldr that drops its rest ends the list there (a takeWhile by hand)
  print (sum (foldr (\x rest -> if x < 5 then x : rest else []) [] [1 ..]))
  print (length (foldr (\x rest -> if even x then [x, x] else [x]) [] [1 .. 5]))
  print (sum (foldr (\x rest -> if x > 3 then [100] else x : rest) [999] [1 .. 10]))
  -- drop, dropWhile, zip3, zipWith3
  print (sum (drop 3 [1 .. 10]), sum (drop 0 [1 .. 3]), sum (drop 20 [1 .. 3]), sum (take 3 (drop 5 [1 ..])))
  print (sum (dropWhile (< 5) [1 .. 10]), sum (dropWhile (< 5) [7, 1, 2]), length (dropWhile even [2, 4, 6]))
  print (sum (zipWith3 (\a b c -> a * b + c) [1 .. 4] [10, 20 ..] (repeat 1)), length (zip3 [1 .. 5] [1 .. 3] [1 ..]))
  print (sum (map (\(a, b, c) -> a + b + c) (zip3 [1, 2] [10, 20] [100, 200, 300])))
  -- a foldr that is recursion: its elements kept, the step taken from the last back
  print (foldr (\x acc -> x + 2 * acc) 0 [1 .. 10], foldr (-) 0 [1 .. 10], foldr (\x acc -> x - acc) 100 (filter odd [1 .. 9]))
  print (foldr (+) 0 [1 .. 3000000])
  -- steps that call what may fail, before the rest (computed with the
  -- elements, forward) and after it (from the last back)
  print (foldr max 0 [3, 1, 4, 1, 5, 9, 2, 6], foldr (\x r -> x `mod` 7 + r) 0 [1 .. 100000], foldr (\x r -> digits x + r) 0 [1 .. 100000])
  print (foldr (\x r -> let y = x * 3 in y - r) 0 [1 .. 10], foldr (\x r -> let s = r + x in s * 2 `mod` 1000003) 1 [1 .. 1000])
  print (foldr (\x r -> if r > 100 then r - x else r + x * x) 0 [1 .. 50], foldr (\x r -> case r of (a, b) -> (a + x, max b (x `mod` 13))) (0, 0) [1 .. 100])
  print (foldr (\x r -> x + r) 0 (map (\x -> 100 `div` x) [1 .. 50]), foldr (\x r -> x `div` (r + 1)) 1000 [3, 2, 5])
  print (foldr max 0 [1 .. 3000000], foldr (\x r -> digits x + r) 0 (map (* 7) [1 .. 3000000]))
  -- the rest used again after it is forced, also in closures kept in the result
  print (map (\f -> f 1) (snd (foldr (\x r -> case r of (n, fs) -> (n + x, (\y -> fst r * y + x) : fs)) (0, []) [1 .. 4])))
  -- from the last element of a range back: its ends, empty ones, maps and filters
  print (foldr (\x r -> x - r) 0 [maxBound - 3 .. maxBound :: Int], foldr (\x r -> x - r) 0 [minBound .. minBound + 3 :: Int])
  print (foldr (+) 7 [5 .. 1], foldr (\x r -> x - r) 0 [3 .. 3], foldr (\x r -> x - r) 0 (map (* 3) (filter odd [1 .. 20])))
  -- Iter.drop, Iter.dropWhile, Iter.find and what is made of it
  print (Iter.sum (Iter.drop 2 (Iter.range 1 5)), Iter.sum (Iter.dropWhile odd (Iter.fromList [1, 3, 4, 5])))
  print (Iter.find (> 3) (Iter.map (* 2) (Iter.from 1)), Iter.any even (Iter.range 1 5), Iter.all odd (Iter.range 1 5), Iter.elem 4 (Iter.range 1 3))
  print (Iter.head (do
    x <- Iter.from 1
    y <- Iter.range 1 x
    if x * y == 12 then pure (x, y) else Iter.fromList []))

digits :: Int -> Int
digits n = if n < 10 then 1 else 1 + digits (n `div` 10)
