-- Files and the command line. Reading or writing a file can fail, so the
-- result is an Either; Data.String works on String without unpacking it.
import qualified Data.String as S
import System.Environment

main :: IO ()
main = do
  args <- getArgs
  print args
  w <- writeFile "notes.txt" (S.intercalate "\n" ["first", "second", "third"])
  print w
  r <- readFile "notes.txt"
  case r of
    Right s -> do
      print (S.length s, S.uncons s, S.isPrefixOf "fir" s, S.stripPrefix "first\n" s)
      print (S.elem 'w' s, S.null s, S.null "", S.replicate 3 "ab", S.concat ["a", "b", "c"])
    Left err -> putStrLn err
  missing <- readFile "no/such/file"
  putStrLn (either (const "no such file") id missing)
