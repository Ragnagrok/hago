-- Actions at the same time, without handling threads.
import Control.Concurrent
import Control.Concurrent.Async

slowly :: Int -> a -> IO a
slowly ms x = threadDelay (ms * 1000) >> pure x

main :: IO ()
main = do
  task <- async (slowly 20 "done")
  poll task >>= print
  wait task >>= putStrLn
  poll task >>= print
  concurrently (slowly 10 'x') (slowly 5 True) >>= print
  race (slowly 300 "slow") (slowly 1 (42 :: Int)) >>= print
  race (pure "fast") (slowly 300 'x') >>= print
  -- the results come in the order of the list, whatever order they finish in
  mapConcurrently (\n -> slowly (50 - n * 10) (n * n)) [1 .. 4] >>= print
  forConcurrently (unpack "abc") (\c -> pure (pack [c, c])) >>= print
  mapConcurrently_ (slowly 1) [(), ()]
  -- Concurrently: <*> runs both sides at once, <|> keeps the first to finish
  runConcurrently ((,) <$> Concurrently (slowly 30 'a') <*> Concurrently (slowly 10 True)) >>= print
  runConcurrently (traverse (\n -> Concurrently (slowly (50 - n * 10) (n * n))) [1 .. 4]) >>= print
  runConcurrently (Concurrently (slowly 300 "slow") <|> Concurrently (slowly 1 "fast")) >>= putStrLn
  runConcurrently (Concurrently (slowly 1 "alone") <|> empty) >>= putStrLn
  runConcurrently (Concurrently (slowly 20 "ab") <> Concurrently (slowly 5 "cd") <> mempty) >>= putStrLn
  putStrLn "all finished"
