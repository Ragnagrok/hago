-- Wadler's pretty printer, in the form Lindig gave it for strict languages
-- ("Strictly Pretty", 2000): a group is printed flat when it fits in what is
-- left of the line, and the choice is made by measuring instead of by building
-- both layouts lazily.
module Text.Pretty
  ( Doc, text, line, linebreak, nest, group, hsep, punctuate, layout, render
  ) where

import qualified Data.String as S


-- Line s is a line break, or s where its group is printed flat.
data Doc = Nil | Text String | Line String | Cat Doc Doc | Nest Int Doc | Group Doc

instance Semigroup Doc where
  a <> b = Cat a b

instance Monoid Doc where
  mempty = Nil

text :: String -> Doc
text s = Text s

-- A line break, or a space.
line :: Doc
line = Line " "

-- A line break, or nothing.
linebreak :: Doc
linebreak = Line ""

nest :: Int -> Doc -> Doc
nest i d = Nest i d

group :: Doc -> Doc
group d = Group d

hsep :: [Doc] -> Doc
hsep [] = Nil
hsep [d] = d
hsep (d : ds) = d <> text " " <> hsep ds

punctuate :: Doc -> [Doc] -> [Doc]
punctuate _ [] = []
punctuate _ [d] = [d]
punctuate p (d : ds) = (d <> p) : punctuate p ds

data Mode = Flat | Break

-- What is left to print after the document at hand, each with its
-- indentation and mode: a type of its own instead of a list of triples, so a
-- push is one allocation (a list's cell would take another for the rest,
-- suspended). The document at hand is kept apart, so only the second half
-- of a Cat is pushed.
data Stack = Done | Push Int Mode Doc Stack

-- Whether the rest of the line holds everything up to the next break: d at
-- indentation i in mode m, then z.
fits :: Int -> Int -> Mode -> Doc -> Stack -> Bool
fits w i m d z
  | w < 0 = False
  | otherwise = case d of
      Nil -> case z of
        Done -> True
        Push i' m' d' z' -> fits w i' m' d' z'
      Text s -> fits (w - S.length s) i m Nil z
      Line s -> case m of
        Flat -> fits (w - S.length s) i m Nil z
        Break -> True
      Cat a b -> fits w i m a (Push i m b z)
      Nest j x -> fits w (i + j) m x z
      Group x -> fits w i Flat x z

-- The pieces of the text, in order; the list is built as it is consumed.
layout :: Int -> Doc -> [String]
layout w d = go 0 0 Break d Done
  where
    -- at column k, x at indentation i in mode m, then z
    go k i m x z = case x of
      Nil -> case z of
        Done -> []
        Push i' m' x' z' -> go k i' m' x' z'
      Text s -> s : go (k + S.length s) i m Nil z
      Line s -> case m of
        Flat -> s : go (k + S.length s) i m Nil z
        Break -> ("\n" ++ S.replicate i " ") : go i i m Nil z
      Cat a b -> go k i m a (Push i m b z)
      Nest j y -> go k (i + j) m y z
      Group y -> case m of
        Flat -> go k i Flat y z
        Break -> if fits (w - k) i Flat y z then go k i Flat y z else go k i Break y z

render :: Int -> Doc -> String
render w d = S.concat (layout w d)
