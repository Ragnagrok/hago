-- Parser combinators in the style of Parsec: a parser that fails after
-- consuming input does not let <|> try the next one, so a choice looks at one
-- character and errors point at the place where the input went wrong. An
-- error lists everything that would have been accepted there.
--
-- The input is a String, read from the front with Data.String.uncons and
-- span, which take no copy: unpacking it into a [Char] first made parsing
-- four times slower. takeWhileP takes a run of characters in one step.
module Text.Parser
  ( Parser, Pos (..), ParseError (..), parse, showError
  , satisfy, takeWhileP, takeWhile1P, match, char, string, eof, oneOf, noneOf, label, (<?>)
  , many, some, skipMany, sepBy, sepBy1, between, option, spaces, count
  ) where

import qualified Data.String as S

infix 0 <?>

data Pos = Pos { line :: Int, column :: Int } deriving (Eq, Ord, Show)

-- The input left where the error is: only its first character is shown, but
-- keeping it costs nothing, as it shares the text being parsed.
data ParseError = ParseError { at :: Pos, expected :: [String], left :: String }

-- What a parser gives: its value, or Nothing if it failed; the input left
-- after it, or where it failed; and what would have been accepted there,
-- which choices made later can add to. It is one constructor small enough
-- to be kept by value, so a step allocates nothing.
--
-- A parser consumed input when what it leaves is not what it was given:
-- both are suffixes of the same text, so comparing them takes constant
-- time. The place of an error is only worked out, from the text and what
-- is left of it, when parse returns the error.
data Reply a = Reply (Maybe a) String [String]

newtype Parser a = Parser (String -> Reply a)

runP :: Parser a -> String -> Reply a
runP (Parser f) s = f s

parse :: Parser a -> String -> Either ParseError a
parse p s = case runP p s of
  Reply (Just x) _ _ -> Right x
  Reply Nothing rest e -> Left (ParseError (position s rest) e rest)

-- Where rest starts in s, which ends with it.
position :: String -> String -> Pos
position s rest = go 1 1 s
  where
    go l c t
      | t == rest = Pos l c
      | otherwise = case S.uncons t of
          Just ('\n', t') -> go (l + 1) 1 t'
          Just (_, t') -> go l (c + 1) t'
          Nothing -> Pos l c

showError :: ParseError -> String
showError e =
  "line " ++ show e.at.line ++ ", column " ++ show e.at.column ++ ": unexpected "
    ++ maybe "end of input" (\(c, _) -> show c) (S.uncons e.left)
    ++ expecting (nubStrings e.expected)
  where
    expecting [] = ""
    expecting [x] = ", expected " ++ x
    expecting xs = ", expected " ++ commaList xs
    commaList [x, y] = x ++ " or " ++ y
    commaList (x : xs) = x ++ ", " ++ commaList xs
    commaList [] = ""

nubStrings :: [String] -> [String]
nubStrings [] = []
nubStrings (x : xs) = x : nubStrings (filter (/= x) xs)

-- What was expected after a parser that left rest1 and expected e1, and
-- then one that left rest2 and expected e2: if the second consumed, only
-- its own; otherwise both, as they are at the same place.
after :: String -> [String] -> String -> [String] -> [String]
after rest1 e1 rest2 e2
  | rest2 /= rest1 = e2
  | null e1 = e2
  | null e2 = e1
  | otherwise = e1 ++ e2

instance Functor Parser where
  fmap f p = Parser (\s -> case runP p s of
    Reply (Just x) rest e -> Reply (Just (f x)) rest e
    Reply Nothing rest e -> Reply Nothing rest e)

-- liftA2, *> and <* run both parsers directly, instead of through >>=,
-- which would make a parser for the second on every run.
instance Applicative Parser where
  pure x = Parser (\s -> Reply (Just x) s [])
  pf <*> px = liftA2 id pf px
  liftA2 f pa pb = Parser (\s -> case runP pa s of
    Reply Nothing rest e -> Reply Nothing rest e
    Reply (Just a) rest1 e1 -> case runP pb rest1 of
      Reply Nothing rest2 e2 -> Reply Nothing rest2 (after rest1 e1 rest2 e2)
      Reply (Just b) rest2 e2 -> Reply (Just (f a b)) rest2 (after rest1 e1 rest2 e2))
  pa *> pb = Parser (\s -> case runP pa s of
    Reply Nothing rest e -> Reply Nothing rest e
    Reply (Just _) rest1 e1 -> case runP pb rest1 of
      Reply y rest2 e2 -> Reply y rest2 (after rest1 e1 rest2 e2))
  pa <* pb = Parser (\s -> case runP pa s of
    Reply Nothing rest e -> Reply Nothing rest e
    Reply (Just a) rest1 e1 -> case runP pb rest1 of
      Reply Nothing rest2 e2 -> Reply Nothing rest2 (after rest1 e1 rest2 e2)
      Reply (Just _) rest2 e2 -> Reply (Just a) rest2 (after rest1 e1 rest2 e2))

instance Monad Parser where
  p >>= k = Parser (\s -> case runP p s of
    Reply Nothing rest e -> Reply Nothing rest e
    Reply (Just x) rest1 e1 -> case runP (k x) rest1 of
      Reply y rest2 e2 -> Reply y rest2 (after rest1 e1 rest2 e2))

instance Alternative Parser where
  empty = Parser (\s -> Reply Nothing s [])
  p <|> q = Parser (\s -> case runP p s of
    Reply Nothing rest1 e1 | rest1 == s -> case runP q s of
      Reply y rest2 e2 | rest2 == s -> Reply y rest2 (after s e1 s e2)
      other -> other
    other -> other)

satisfy :: (Char -> Bool) -> Parser Char
satisfy f = Parser (\s -> case S.uncons s of
  Just (c, cs) | f c -> Reply (Just c) cs []
  _ -> Reply Nothing s [])

-- The longest run of characters that satisfy f, maybe none, in one step:
-- many (satisfy f <?> name), without a step per character. Where the run
-- stops, the error expects the name, if there is one.
takeWhileP :: Maybe String -> (Char -> Bool) -> Parser String
takeWhileP name f =
  let e = maybe [] (\n -> [n]) name
   in Parser (\s -> case S.span f s of (run, rest) -> Reply (Just run) rest e)

-- The same, but at least one.
takeWhile1P :: Maybe String -> (Char -> Bool) -> Parser String
takeWhile1P name f =
  let e = maybe [] (\n -> [n]) name
   in Parser (\s -> case S.span f s of
        (run, rest) -> Reply (if S.null run then Nothing else Just run) rest e)

-- What p consumed, a slice of the input, with its value.
match :: Parser a -> Parser (String, a)
match p = Parser (\s -> case runP p s of
  Reply (Just x) rest e -> Reply (Just (maybe "" id (S.stripSuffix rest s), x)) rest e
  Reply Nothing rest e -> Reply Nothing rest e)

-- When p fails without consuming, it expected the thing called name. The
-- lists of what is expected are made once, with the parser, not on each run.
label :: String -> Parser a -> Parser a
label name p =
  let e = [name]
   in Parser (\s -> case runP p s of
        Reply x rest _ | rest == s -> Reply x rest e
        other -> other)

(<?>) :: Parser a -> String -> Parser a
p <?> name = label name p

char :: Char -> Parser Char
char c = satisfy (== c) <?> show c

-- The whole string or nothing: a failure consumes no input.
string :: String -> Parser String
string str =
  let e = [show str]
   in Parser (\s -> case S.stripPrefix str s of
        Just rest -> Reply (Just str) rest []
        Nothing -> Reply Nothing s e)

eof :: Parser ()
eof = let e = ["end of input"] in Parser (\s -> if S.null s then Reply (Just ()) s [] else Reply Nothing s e)

oneOf :: String -> Parser Char
oneOf cs = satisfy (\c -> S.elem c cs)

noneOf :: String -> Parser Char
noneOf cs = satisfy (\c -> not (S.elem c cs))

-- Zero or more, as a loop. p must consume when it succeeds, or many would
-- never stop.
many :: Parser a -> Parser [a]
many p = Parser (\s -> go [] s)
  where
    go acc s = case runP p s of
      Reply (Just x) rest _
        | rest /= s -> go (x : acc) rest
        | otherwise -> error "many: the parser succeeded without consuming input"
      Reply Nothing rest e
        | rest == s -> Reply (Just (reverse acc)) s e
        | otherwise -> Reply Nothing rest e

some :: Parser a -> Parser [a]
some p = liftA2 (:) p (many p)

-- many, without keeping what p returns.
skipMany :: Parser a -> Parser ()
skipMany p = Parser (\s -> go s)
  where
    go s = case runP p s of
      Reply (Just _) rest _
        | rest /= s -> go rest
        | otherwise -> error "skipMany: the parser succeeded without consuming input"
      Reply Nothing rest e
        | rest == s -> Reply (Just ()) s e
        | otherwise -> Reply Nothing rest e

sepBy :: Parser a -> Parser s -> Parser [a]
sepBy p sep = sepBy1 p sep <|> pure []

sepBy1 :: Parser a -> Parser s -> Parser [a]
sepBy1 p sep = liftA2 (:) p (many (sep *> p))

between :: Parser o -> Parser c -> Parser a -> Parser a
between open close p = open *> p <* close

option :: a -> Parser a -> Parser a
option x p = p <|> pure x

count :: Int -> Parser a -> Parser [a]
count n p = sequenceA (replicate n p)

-- White space is never what an error says was expected.
spaces :: Parser ()
spaces = () <$ takeWhileP Nothing isSpace
