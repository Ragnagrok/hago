-- An HTTP server from Go's net/http, and clients that ask it at the same
-- time. Go calls the handler on a goroutine of its own for each request, so
-- the visits are counted in an MVar.
import Control.Concurrent
import Control.Concurrent.Async
import qualified Network.HTTP as HTTP

foreign import go type "net.Listener" Listener
foreign import go type "*net/http.ServeMux" ServeMux
foreign import go type "net/http.ResponseWriter" ResponseWriter
foreign import go type "*net/http.Request" Request

foreign import go "net.Listen" listen :: String -> String -> IO (Either String Listener)
foreign import go ".Addr().String()" address :: Listener -> String
foreign import go "net/http.NewServeMux" newServeMux :: IO ServeMux
foreign import go ".HandleFunc" handleFunc :: ServeMux -> String -> (ResponseWriter -> Request -> IO ()) -> IO ()
foreign import go "net/http.Serve" serve :: Listener -> ServeMux -> IO (Either String ())
foreign import go ".URL.Query().Get" queryParam :: Request -> String -> String
foreign import go "fmt.Fprint" write :: ResponseWriter -> String -> IO ()

greet :: MVar Int -> ResponseWriter -> Request -> IO ()
greet visits w r = do
  modifyMVar_ visits (pure . (+ 1))
  let name = queryParam r "name"
  write w ("hello, " ++ (if name == "" then "stranger" else name))

-- Network.HTTP is the client; the server above uses net/http directly
fetch :: String -> IO String
fetch url = do
  answer <- HTTP.get url
  pure (either ("failed: " ++) (\r -> show r.status ++ " " ++ r.body) answer)

main :: IO ()
main = do
  visits <- newMVar 0
  mux <- newServeMux
  handleFunc mux "/hello" (greet visits)
  listening <- listen "tcp" "127.0.0.1:0"
  case listening of
    Left err -> putStrLn ("cannot listen: " ++ err)
    Right listener -> do
      forkIO (serve listener mux >> pure ())
      let base = "http://" ++ address listener
      pages <- mapConcurrently fetch [base ++ "/hello?name=" ++ n | n <- ["Ada", "Alan", "Grace", ""]]
      mapM_ putStrLn pages
      fetch (base ++ "/nowhere") >>= putStrLn
      readMVar visits >>= print
