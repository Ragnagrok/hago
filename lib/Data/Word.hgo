-- Word64 ------------------------------------------------------------------------

instance Eq Word64 where
  x == y = primEq x y
  x /= y = primNeq x y

instance Ord Word64 where
  x < y = primLt x y
  x <= y = primLe x y
  x > y = primGt x y
  x >= y = primGe x y
  compare x y = if primLt x y then LT else if primEq x y then EQ else GT

instance Show Word64 where
  show x = primShow x
  showsPrec _ x = primShow x

instance Num Word64 where
  x + y = primAdd x y
  x - y = primSub x y
  x * y = primMul x y
  negate x = primNeg x
  fromInteger n = fromIntOf n

instance Integral Word64 where
  div x y = divOf x y
  mod x y = modOf x y
  quot x y = quotOf x y
  rem x y = remOf x y
  toInt x = toIntOf x
  toInteger x = uint64ToInteger (toUint64 x)

instance Bounded Word64 where
  minBound = 0
  maxBound = complement 0

instance Enum Word64 where
  fromEnum x = toIntOf x
  toEnum n = if toIntOf (fromIntOf n :: Word64) == n then Just (fromIntOf n) else Nothing
  succ x = if x == maxBound then Nothing else Just (x + 1)
  pred x = if x == minBound then Nothing else Just (x - 1)

instance Bits Word64 where
  a .&. b = bitAnd a b
  a .|. b = bitOr a b
  xor a b = bitXor a b
  complement a = bitNot a
  shiftL a n = bitShiftL a n
  shiftR a n = bitShiftR a n
  testBit a i = bitTest a i
  popCount a = bitCount a

instance FiniteBits Word64 where
  finiteBitSize a = bitSize a
  countLeadingZeros a = bitLeading a
  countTrailingZeros a = bitTrailing a

-- Word ------------------------------------------------------------------------

instance Eq Word where
  x == y = primEq x y
  x /= y = primNeq x y

instance Ord Word where
  x < y = primLt x y
  x <= y = primLe x y
  x > y = primGt x y
  x >= y = primGe x y
  compare x y = if primLt x y then LT else if primEq x y then EQ else GT

instance Show Word where
  show x = primShow x
  showsPrec _ x = primShow x

instance Num Word where
  x + y = primAdd x y
  x - y = primSub x y
  x * y = primMul x y
  negate x = primNeg x
  fromInteger n = fromIntOf n

instance Integral Word where
  div x y = divOf x y
  mod x y = modOf x y
  quot x y = quotOf x y
  rem x y = remOf x y
  toInt x = toIntOf x
  toInteger x = uint64ToInteger (toUint64 x)

instance Bounded Word where
  minBound = 0
  maxBound = complement 0

instance Enum Word where
  fromEnum x = toIntOf x
  toEnum n = if toIntOf (fromIntOf n :: Word) == n then Just (fromIntOf n) else Nothing
  succ x = if x == maxBound then Nothing else Just (x + 1)
  pred x = if x == minBound then Nothing else Just (x - 1)

instance Bits Word where
  a .&. b = bitAnd a b
  a .|. b = bitOr a b
  xor a b = bitXor a b
  complement a = bitNot a
  shiftL a n = bitShiftL a n
  shiftR a n = bitShiftR a n
  testBit a i = bitTest a i
  popCount a = bitCount a

instance FiniteBits Word where
  finiteBitSize a = bitSize a
  countLeadingZeros a = bitLeading a
  countTrailingZeros a = bitTrailing a
