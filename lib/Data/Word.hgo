-- Unsigned integers of fixed sizes, as Haskell's Data.Word: Go's uint8,
-- uint16, uint32, uint64 and uint. Arithmetic wraps around, and
-- fromIntegral keeps the low bits: fromIntegral (300 :: Int) :: Word8 is 44.
-- They are Num, Integral, Enum, Bounded, Bits and FiniteBits.
module Data.Word (Word8, Word16, Word32, Word64, Word) where

import Data.Bits

foreign import go type "uint8" Word8
foreign import go type "uint16" Word16
foreign import go type "uint32" Word32
foreign import go type "uint64" Word64
foreign import go type "uint" Word

foreign import go "rt_fromInt" fromIntOf :: Int -> a
foreign import go "rt_toInt" toIntOf :: a -> Int
foreign import go "rt_quotOf" quotOf :: a -> a -> a
foreign import go "rt_remOf" remOf :: a -> a -> a
foreign import go "rt_divOf" divOf :: a -> a -> a
foreign import go "rt_modOf" modOf :: a -> a -> a
foreign import go "rt_bitAnd" bitAnd :: a -> a -> a
foreign import go "rt_bitOr" bitOr :: a -> a -> a
foreign import go "rt_bitXor" bitXor :: a -> a -> a
foreign import go "rt_bitNot" bitNot :: a -> a
foreign import go "rt_shiftL" bitShiftL :: a -> Int -> a
foreign import go "rt_shiftR" bitShiftR :: a -> Int -> a
foreign import go "rt_bitTest" bitTest :: a -> Int -> Bool
foreign import go "rt_popCount" bitCount :: a -> Int
foreign import go "rt_bitSize" bitSize :: a -> Int
foreign import go "rt_leadingZeros" bitLeading :: a -> Int
foreign import go "rt_trailingZeros" bitTrailing :: a -> Int
foreign import go "rt_wordToUint64" toUint64 :: a -> Word64
foreign import go "rt_wordToInteger" uint64ToInteger :: Word64 -> Integer

-- Word8 ------------------------------------------------------------------------

instance Eq Word8 where
  x == y = primEq x y
  x /= y = primNeq x y

instance Ord Word8 where
  x < y = primLt x y
  x <= y = primLe x y
  x > y = primGt x y
  x >= y = primGe x y
  compare x y = if primLt x y then LT else if primEq x y then EQ else GT

instance Show Word8 where
  show x = primShow x
  showsPrec _ x = primShow x

instance Num Word8 where
  x + y = primAdd x y
  x - y = primSub x y
  x * y = primMul x y
  negate x = primNeg x
  fromInteger n = fromIntOf n

instance Integral Word8 where
  div x y = divOf x y
  mod x y = modOf x y
  quot x y = quotOf x y
  rem x y = remOf x y
  toInt x = toIntOf x

instance Bounded Word8 where
  minBound = 0
  maxBound = 255

instance Enum Word8 where
  fromEnum x = toIntOf x
  toEnum n = if toIntOf (fromIntOf n :: Word8) == n then Just (fromIntOf n) else Nothing
  succ x = if x == maxBound then Nothing else Just (x + 1)
  pred x = if x == minBound then Nothing else Just (x - 1)

instance Bits Word8 where
  a .&. b = bitAnd a b
  a .|. b = bitOr a b
  xor a b = bitXor a b
  complement a = bitNot a
  shiftL a n = bitShiftL a n
  shiftR a n = bitShiftR a n
  testBit a i = bitTest a i
  popCount a = bitCount a

instance FiniteBits Word8 where
  finiteBitSize a = bitSize a
  countLeadingZeros a = bitLeading a
  countTrailingZeros a = bitTrailing a

