-- Int64 ------------------------------------------------------------------------

instance Eq Int64 where
  x == y = primEq x y
  x /= y = primNeq x y

instance Ord Int64 where
  x < y = primLt x y
  x <= y = primLe x y
  x > y = primGt x y
  x >= y = primGe x y
  compare x y = if primLt x y then LT else if primEq x y then EQ else GT

instance Show Int64 where
