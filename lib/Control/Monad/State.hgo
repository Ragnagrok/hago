-- State over any monad, and the MonadState class, as in mtl. State s is
-- StateT s Identity, and Identity is trampolined, so a long loop in State
-- runs in constant stack, as one in StateT s IO does.
module Control.Monad.State
  ( StateT (..), runStateT, evalStateT, execStateT
  , State, runState, evalState, execState
  , MonadState (..), modify, gets
  , module Control.Monad.Trans
  , module Data.Functor.Identity
  ) where

import Control.Monad.Trans
import Data.Functor.Identity

newtype StateT s m a = StateT (s -> m (a, s))

runStateT :: StateT s m a -> s -> m (a, s)
runStateT (StateT f) s = f s

evalStateT :: Monad m => StateT s m a -> s -> m a
evalStateT m s = fmap fst (runStateT m s)

execStateT :: Monad m => StateT s m a -> s -> m s
execStateT m s = fmap snd (runStateT m s)

type State s = StateT s Identity

runState :: State s a -> s -> (a, s)
runState m s = runIdentity (runStateT m s)

evalState :: State s a -> s -> a
evalState m s = fst (runState m s)

execState :: State s a -> s -> s
execState m s = snd (runState m s)

instance Functor m => Functor (StateT s m) where
  fmap f m = StateT (\s -> fmap (\(a, s') -> (f a, s')) (runStateT m s))

instance Monad m => Applicative (StateT s m) where
  pure a = StateT (\s -> pure (a, s))
  mf <*> mx = mf >>= \f -> fmap f mx
  m *> k = m >>= \_ -> k

instance Monad m => Monad (StateT s m) where
  m >>= k = StateT (\s -> runStateT m s >>= \(a, s') -> runStateT (k a) s')

instance MonadTrans (StateT s) where
  lift m = StateT (\s -> fmap (\a -> (a, s)) m)

instance MonadIO m => MonadIO (StateT s m) where
  liftIO m = lift (liftIO m)

instance MonadRec m => MonadRec (StateT s m) where
  tailRecM f a = StateT (\s0 -> tailRecM (\(x, s) -> fmap next (runStateT (f x) s)) (a, s0))
    where
      next (Left x', s') = Left (x', s')
      next (Right b, s') = Right (b, s')

class Monad m => MonadState s m | m -> s where
  get :: m s
  put :: s -> m ()

instance Monad m => MonadState s (StateT s m) where
  get = StateT (\s -> pure (s, s))
  put s = StateT (\_ -> pure ((), s))

modify :: MonadState s m => (s -> s) -> m ()
modify f = get >>= \s -> put (f s)

gets :: MonadState s m => (s -> a) -> m a
gets f = fmap f get
