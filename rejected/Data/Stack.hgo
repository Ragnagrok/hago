-- An abstract type: Stack is exported, its constructor is not.
module Data.Stack (Stack, empty, push, pop, toList) where

data Stack a = Stack { items :: [a] }

-- These shadow the Prelude's empty and toList inside this module.
empty :: Stack a
empty = Stack []

push :: a -> Stack a -> Stack a
push x (Stack xs) = Stack (x : xs)

pop :: Stack a -> Maybe (a, Stack a)
pop (Stack []) = Nothing
pop (Stack (x:xs)) = Just (x, Stack xs)

toList :: Stack a -> [a]
toList (Stack xs) = xs

-- Instances are global: importing the module brings it.
instance Show a => Show (Stack a) where
  show (Stack xs) = "Stack " ++ show xs
