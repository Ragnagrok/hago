-- The Hago prelude, compiled together with every program.
--
-- The class hierarchy is Haskell's with its known mistakes fixed:
--   * Functor => Applicative => Monad, and return is just pure.
--   * Semigroup => Monoid, and <> is the only way to combine.
--   * fail lives in MonadFail, not in Monad.
--   * Folding and traversing work on any Foldable or Traversable;
--     traverse_ only asks for Applicative, and mapM is traverse.
--   * Num is a ring: abs and signum need an order, so they are functions
--     on (Ord a, Num a). Decimal literals are overloaded through Fractional.
--   * No partial functions: head, tail, !!, maximum and minimum return Maybe.
--   * No Foldable instance for tuples, so length (1, 2) is a type error.
--   * foldl is strict, because the language is.
--   * Long monadic loops have MonadRec (tailRecM), and IO is trampolined,
--     since a strict language cannot rely on laziness to keep the stack flat.

infixr 9 .
infixr 8 ^, **
infixl 7 *, /, `div`, `mod`, `quot`, `rem`
infixl 6 +, -
infixr 6 <>
infixr 5 ++
infix 4 ==, /=, <, <=, >, >=
infixl 4 <$>, <$, <*>, *>, <*
infixl 3 <|>
infixr 3 &&
infixr 2 ||
infixl 1 >>=, >>
infixr 1 =<<
infixr 0 $
infixl 9 !!

data Maybe a = Nothing | Just a deriving (Eq, Ord, Show, Read)
data Either a b = Left a | Right b deriving (Eq, Ord, Show, Read)
data Ordering = LT | EQ | GT deriving (Eq, Ord, Show, Read, Enum, Bounded)

-- Functions ----------------------------------------------------------------

id :: a -> a
id x = x

const :: a -> b -> a
const x _ = x

flip :: (a -> b -> c) -> b -> a -> c
flip f x y = f y x

(.) :: (b -> c) -> (a -> b) -> a -> c
(.) f g = \x -> f (g x)

($) :: (a -> b) -> a -> b
($) f x = f x

curry :: ((a, b) -> c) -> a -> b -> c
curry f x y = f (x, y)

uncurry :: (a -> b -> c) -> (a, b) -> c
uncurry f (x, y) = f x y

undefined :: a
undefined = error "undefined"

-- The second argument is suspended, so these short-circuit.
(&&) :: Bool -> Lazy Bool -> Bool
True && b = b
False && _ = False

(||) :: Bool -> Lazy Bool -> Bool
True || _ = True
False || b = b

not :: Bool -> Bool
not True = False
not False = True

otherwise :: Bool
otherwise = True

fst :: (a, b) -> a
fst (x, _) = x

snd :: (a, b) -> b
snd (_, y) = y

maybe :: b -> (a -> b) -> Maybe a -> b
maybe d _ Nothing = d
maybe _ f (Just x) = f x

fromMaybe :: a -> Maybe a -> a
fromMaybe d Nothing = d
fromMaybe _ (Just x) = x

either :: (a -> c) -> (b -> c) -> Either a b -> c
either f _ (Left x) = f x
either _ g (Right y) = g y

-- Equality, order, showing --------------------------------------------------

class Eq a where
  (==), (/=) :: a -> a -> Bool
  x /= y = not (x == y)
  x == y = not (x /= y)

class Eq a => Ord a where
  compare :: a -> a -> Ordering
  (<), (<=), (>), (>=) :: a -> a -> Bool
  max, min :: a -> a -> a
  compare x y = if x == y then EQ else if x <= y then LT else GT
  x < y = case compare x y of
    LT -> True
    _ -> False
  x <= y = case compare x y of
    GT -> False
    _ -> True
  x > y = case compare x y of
    GT -> True
    _ -> False
  x >= y = case compare x y of
    LT -> False
    _ -> True
  max x y = if x <= y then y else x
  min x y = if x <= y then x else y

class Show a where
  show :: a -> String
  showsPrec :: Int -> a -> String
  show x = showsPrec 0 x
  showsPrec _ x = show x

-- Used by derived instances.
thenCmp :: Ordering -> Lazy Ordering -> Ordering
thenCmp x y = x <> y

showParenString :: Bool -> String -> String
showParenString True s = "(" ++ s ++ ")"
showParenString False s = s

-- Semigroups and monoids ------------------------------------------------------

-- The right operand is lazy, as for ++.
class Semigroup a where
  (<>) :: a -> Lazy a -> a

class Semigroup a => Monoid a where
  mempty :: a

-- One after the other: two lists, two Strings, or two values of any other
-- Semigroup. The second is only computed when it is needed.
(++) :: Semigroup a => a -> Lazy a -> a
a ++ b = a <> b

mconcat :: Monoid a => [a] -> a
mconcat xs = foldr (<>) mempty xs

data Sum a = Sum a deriving (Eq, Ord, Show)
data Product a = Product a deriving (Eq, Ord, Show)
data All = All Bool deriving (Eq, Ord, Show)
data Any = Any Bool deriving (Eq, Ord, Show)

getSum :: Sum a -> a
getSum (Sum x) = x

getProduct :: Product a -> a
getProduct (Product x) = x

getAll :: All -> Bool
getAll (All b) = b

getAny :: Any -> Bool
getAny (Any b) = b

instance Semigroup [a] where
  xs <> ys = primAppend xs ys

instance Monoid [a] where
  mempty = []

instance Semigroup String where
  a <> b = primAppend a b

instance Monoid String where
  mempty = ""

instance Semigroup Ordering where
  LT <> _ = LT
  EQ <> y = y
  GT <> _ = GT

instance Monoid Ordering where
  mempty = EQ

instance Semigroup () where
  _ <> _ = ()

instance Monoid () where
  mempty = ()

instance Semigroup a => Semigroup (Maybe a) where
  Nothing <> y = y
  Just a <> y = case y of
    Nothing -> Just a
    Just b -> Just (a <> b)

instance Semigroup a => Monoid (Maybe a) where
  mempty = Nothing

instance (Semigroup a, Semigroup b) => Semigroup (a, b) where
  (a, b) <> (c, d) = (a <> c, b <> d)

instance (Monoid a, Monoid b) => Monoid (a, b) where
  mempty = (mempty, mempty)

instance Num a => Semigroup (Sum a) where
  Sum a <> Sum b = Sum (a + b)

instance Num a => Monoid (Sum a) where
  mempty = Sum 0

instance Num a => Semigroup (Product a) where
  Product a <> Product b = Product (a * b)

instance Num a => Monoid (Product a) where
  mempty = Product 1

instance Semigroup All where
  All a <> b = All (a && getAll b)

instance Monoid All where
  mempty = All True

instance Semigroup Any where
  Any a <> b = Any (a || getAny b)

instance Monoid Any where
  mempty = Any False

-- Numbers ----------------------------------------------------------------

-- A ring: no abs or signum, which only make sense with an order.
class Num a where
  (+), (-), (*) :: a -> a -> a
  negate :: a -> a
  fromInteger :: Int -> a
  x - y = x + negate y
  negate x = fromInteger 0 - x

class (Num a, Ord a) => Integral a where
  div, mod, quot, rem :: a -> a -> a
  toInt :: a -> Int
  toInteger :: a -> Integer
  toInteger x = integerFromInt (toInt x)

class Num a => Fractional a where
  (/) :: a -> a -> a
  fromDouble :: Double -> a

class Fractional a => Floating a where
  pi :: a
  sqrt, exp, log, sin, cos :: a -> a
  (**) :: a -> a -> a

abs :: (Ord a, Num a) => a -> a
abs x = if x < 0 then negate x else x

signum :: (Ord a, Num a) => a -> a
signum x = if x < 0 then -1 else if x == 0 then 0 else 1

fromIntegral :: (Integral a, Num b) => a -> b
fromIntegral x = fromInteger (toInt x)

-- The quotient and the remainder together: div and mod, and quot and rem.
divMod, quotRem :: Integral a => a -> a -> (a, a)
divMod x y = (x `div` y, x `mod` y)
quotRem x y = (x `quot` y, x `rem` y)

even, odd :: Integral a => a -> Bool
even n = n `mod` 2 == 0
odd n = not (even n)

subtract :: Num a => a -> a -> a
subtract x y = y - x

gcd :: Integral a => a -> a -> a
gcd a b = if b == 0 then abs a else gcd b (a `mod` b)

lcm :: Integral a => a -> a -> a
lcm x y = if x == 0 || y == 0 then 0 else abs ((x `quot` gcd x y) * y)

logBase :: Floating a => a -> a -> a
logBase b x = log x / log b

(^) :: (Num a, Integral b) => a -> b -> a
(^) x n = if n <= 0 then 1 else x * (x ^ (n - 1))

foreign import go "math.Sqrt" goSqrt :: Double -> Double
foreign import go "math.Exp" goExp :: Double -> Double
foreign import go "math.Log" goLog :: Double -> Double
foreign import go "math.Sin" goSin :: Double -> Double
foreign import go "math.Cos" goCos :: Double -> Double
foreign import go "math.Pow" goPow :: Double -> Double -> Double
foreign import go "math.Floor" goFloor :: Double -> Double
foreign import go "math.Ceil" goCeil :: Double -> Double
foreign import go "math.RoundToEven" goRound :: Double -> Double
foreign import go "math.Pi" goPi :: Double

truncate, floor, ceiling, round :: Double -> Int
truncate x = primTruncate x
floor x = primTruncate (goFloor x)
ceiling x = primTruncate (goCeil x)
round x = primTruncate (goRound x)

instance Eq Int where
  x == y = primEq x y
  x /= y = primNeq x y

instance Ord Int where
  x < y = primLt x y
  x <= y = primLe x y
  x > y = primGt x y
  x >= y = primGe x y
  compare x y = if primLt x y then LT else if primEq x y then EQ else GT

instance Show Int where
  show x = primShow x
  showsPrec d x = if d > 6 && x < 0 then "(" ++ primShow x ++ ")" else primShow x

instance Num Int where
  x + y = primAdd x y
  x - y = primSub x y
  x * y = primMul x y
  negate x = primNeg x
  fromInteger n = n

instance Integral Int where
  div x y = primDiv x y
  mod x y = primMod x y
  quot x y = primQuot x y
  rem x y = primRem x y
  toInt x = x

-- Integer, of any size, is Go's *big.Int.
foreign import go "rt_integerFromInt" integerFromInt :: Int -> Integer
foreign import go "rt_integerFromString" integerFromString :: String -> Integer
foreign import go "rt_integerParse" integerParse :: String -> Either String Integer
foreign import go "rt_integerAdd" integerAdd :: Integer -> Integer -> Integer
foreign import go "rt_integerSub" integerSub :: Integer -> Integer -> Integer
foreign import go "rt_integerMul" integerMul :: Integer -> Integer -> Integer
foreign import go "rt_integerNeg" integerNeg :: Integer -> Integer
foreign import go "rt_integerDiv" integerDiv :: Integer -> Integer -> Integer
foreign import go "rt_integerMod" integerMod :: Integer -> Integer -> Integer
foreign import go "rt_integerQuot" integerQuot :: Integer -> Integer -> Integer
foreign import go "rt_integerRem" integerRem :: Integer -> Integer -> Integer
foreign import go "rt_integerCompare" integerCompare :: Integer -> Integer -> Int
foreign import go "rt_integerShow" integerShow :: Integer -> String
foreign import go "rt_integerToInt" integerToInt :: Integer -> Int
foreign import go "rt_integerToDouble" integerToDouble :: Integer -> Double

instance Eq Integer where
  x == y = integerCompare x y == 0
  x /= y = integerCompare x y /= 0

instance Ord Integer where
  compare x y = compare (integerCompare x y) 0
  x < y = integerCompare x y < 0
  x <= y = integerCompare x y <= 0
  x > y = integerCompare x y > 0
  x >= y = integerCompare x y >= 0

instance Show Integer where
  show x = integerShow x
  showsPrec d x = if d > 6 && x < 0 then "(" ++ integerShow x ++ ")" else integerShow x

instance Num Integer where
  x + y = integerAdd x y
  x - y = integerSub x y
  x * y = integerMul x y
  negate x = integerNeg x
  fromInteger n = integerFromInt n

instance Integral Integer where
  div x y = integerDiv x y
  mod x y = integerMod x y
  quot x y = integerQuot x y
  rem x y = integerRem x y
  toInt x = integerToInt x
  toInteger x = x

instance Eq Double where
  x == y = primEq x y
  x /= y = primNeq x y

instance Ord Double where
  x < y = primLt x y
  x <= y = primLe x y
  x > y = primGt x y
  x >= y = primGe x y
  compare x y = if primLt x y then LT else if primEq x y then EQ else GT

instance Show Double where
  show x = primShow x
  showsPrec d x = if d > 6 && x < 0 then "(" ++ primShow x ++ ")" else primShow x

instance Num Double where
  x + y = primAdd x y
  x - y = primSub x y
  x * y = primMul x y
  negate x = primNeg x
  fromInteger n = primIntToDouble n

instance Fractional Double where
  x / y = primFDiv x y
  fromDouble x = x

instance Floating Double where
  pi = goPi
  sqrt x = goSqrt x
  exp x = goExp x
  log x = goLog x
  sin x = goSin x
  cos x = goCos x
  x ** y = goPow x y

-- Other built-in types ---------------------------------------------------------

instance Eq Char where
  x == y = primEq x y
  x /= y = primNeq x y

instance Ord Char where
  x < y = primLt x y
  x <= y = primLe x y
  x > y = primGt x y
  x >= y = primGe x y
  compare x y = if primLt x y then LT else if primEq x y then EQ else GT

instance Show Char where
  show c = primShow c

instance Eq String where
  x == y = primEq x y
  x /= y = primNeq x y

instance Ord String where
  x < y = primLt x y
  x <= y = primLe x y
  x > y = primGt x y
  x >= y = primGe x y
  compare x y = if primLt x y then LT else if primEq x y then EQ else GT

instance Show String where
  show s = primShow s

instance Eq Bool where
  True == True = True
  False == False = True
  _ == _ = False

instance Ord Bool where
  compare False True = LT
  compare True False = GT
  compare _ _ = EQ

instance Show Bool where
  show True = "True"
  show False = "False"

instance Eq () where
  _ == _ = True

instance Ord () where
  compare _ _ = EQ

instance Show () where
  show _ = "()"

instance Eq a => Eq [a] where
  [] == [] = True
  (x:xs) == (y:ys) = x == y && xs == ys
  _ == _ = False

instance Ord a => Ord [a] where
  compare [] [] = EQ
  compare [] _ = LT
  compare _ [] = GT
  compare (x:xs) (y:ys) = compare x y <> compare xs ys

instance Show a => Show [a] where
  show xs = "[" ++ items xs ++ "]"
    where
      items [] = ""
      items [y] = show y
      items (y:ys) = show y ++ "," ++ items ys

-- Eq, Ord, Show, Bounded and Read for tuples of every size are generated by the compiler
-- (Hago.Driver.tupleInstances).

-- Functor, Applicative, Monad ----------------------------------------------------

class Functor f where
  fmap :: (a -> b) -> f a -> f b
  (<$) :: a -> f b -> f a
  x <$ m = fmap (const x) m

(<$>) :: Functor f => (a -> b) -> f a -> f b
(<$>) g x = fmap g x

class Functor f => Applicative f where
  pure :: a -> f a
  (<*>) :: f (a -> b) -> f a -> f b
  liftA2 :: (a -> b -> c) -> f a -> f b -> f c
  (*>) :: f a -> Lazy (f b) -> f b
  (<*) :: f a -> f b -> f a
  mf <*> mx = liftA2 id mf mx
  liftA2 g x y = fmap g x <*> y
  a *> b = liftA2 (\_ y -> y) a b
  a <* b = liftA2 const a b

class Applicative m => Monad m where
  (>>=) :: m a -> (a -> m b) -> m b

class Monad m => MonadFail m where
  fail :: String -> m a

class Applicative f => Alternative f where
  empty :: f a
  (<|>) :: f a -> Lazy (f a) -> f a

return :: Monad m => a -> m a
return x = pure x

(>>) :: Monad m => m a -> Lazy (m b) -> m b
(>>) m k = m >>= \_ -> k

(=<<) :: Monad m => (a -> m b) -> m a -> m b
(=<<) k m = m >>= k

join :: Monad m => m (m a) -> m a
join mm = mm >>= id

when :: Applicative f => Bool -> Lazy (f ()) -> f ()
when c a = if c then a else pure ()

unless :: Applicative f => Bool -> Lazy (f ()) -> f ()
unless c a = if c then pure () else a

guard :: Alternative f => Bool -> f ()
guard True = pure ()
guard False = empty

instance Functor Maybe where
  fmap _ Nothing = Nothing
  fmap g (Just x) = Just (g x)

instance Applicative Maybe where
  pure x = Just x
  Just g <*> m = fmap g m
  Nothing <*> _ = Nothing

instance Monad Maybe where
  Just x >>= k = k x
  Nothing >>= _ = Nothing

instance MonadFail Maybe where
  fail _ = Nothing

instance Alternative Maybe where
  empty = Nothing
  Nothing <|> r = r
  l <|> _ = l

instance Functor (Either e) where
  fmap _ (Left e) = Left e
  fmap g (Right x) = Right (g x)

instance Applicative (Either e) where
  pure x = Right x
  Right g <*> m = fmap g m
  Left e <*> _ = Left e

instance Monad (Either e) where
  Right x >>= k = k x
  Left e >>= _ = Left e

instance Functor [] where
  fmap g xs = map g xs

instance Applicative [] where
  pure x = [x]
  gs <*> xs = concatMap (\g -> map g xs) gs

instance Monad [] where
  xs >>= k = concatMap k xs

instance MonadFail [] where
  fail _ = []

instance Alternative [] where
  empty = []
  xs <|> ys = xs ++ ys

instance Functor IO where
  fmap g m = primBindIO m (\x -> primReturnIO (g x))

instance Applicative IO where
  pure x = primReturnIO x
  mg <*> mx = primBindIO mg (\g -> primBindIO mx (\x -> primReturnIO (g x)))
  a *> b = primThenIO a b

instance Monad IO where
  m >>= k = primBindIO m k

instance MonadFail IO where
  fail s = error s

-- In a strict language a monadic loop grows the stack unless the monad can
-- run it as a loop. MonadRec is that promise (as in PureScript): tailRecM
-- runs in constant stack. IO is trampolined, so plain recursion in IO is
-- already safe; for other monads, write long loops with tailRecM.
class Monad m => MonadRec m where
  tailRecM :: (a -> m (Either a b)) -> a -> m b

forever :: MonadRec m => m a -> m b
forever act = tailRecM (\u -> fmap (\_ -> Left u) act) ()

instance MonadRec IO where
  tailRecM f a = primBindIO (f a) (\r -> case r of
    Left a' -> tailRecM f a'
    Right b -> primReturnIO b)

instance MonadRec Maybe where
  tailRecM f a = case f a of
    Nothing -> Nothing
    Just (Left a') -> tailRecM f a'
    Just (Right b) -> Just b

instance MonadRec (Either e) where
  tailRecM f a = case f a of
    Left e -> Left e
    Right (Left a') -> tailRecM f a'
    Right (Right b) -> Right b

-- Functions are a reader.
instance Functor ((->) r) where
  fmap g h = \x -> g (h x)

instance Applicative ((->) r) where
  pure x = \_ -> x
  g <*> h = \x -> g x (h x)

instance Monad ((->) r) where
  m >>= k = \r -> k (m r) r

-- Pairs are a writer, when the first component is a monoid.
instance Functor ((,) w) where
  fmap g (w, x) = (w, g x)

instance Monoid w => Applicative ((,) w) where
  pure x = (mempty, x)
  (u, g) <*> (v, x) = (u <> v, g x)

instance Monoid w => Monad ((,) w) where
  (u, x) >>= k = case k x of
    (v, y) -> (u <> v, y)

-- Foldable and Traversable ---------------------------------------------------------

-- foldr's accumulator is lazy, so it can stop early on infinite structures.
class Foldable t where
  foldr :: (a -> Lazy b -> b) -> b -> t a -> b
  foldMap :: Monoid m => (a -> m) -> t a -> m
  foldl :: (b -> a -> b) -> b -> t a -> b
  toList :: t a -> [a]
  null :: t a -> Bool
  foldMap g xs = foldr (\x acc -> g x <> acc) mempty xs
  toList xs = foldr (\x acc -> x : acc) [] xs
  foldl g z xs = listFoldl g z (toList xs)
  null xs = foldr (\_ _ -> False) True xs

class (Functor t, Foldable t) => Traversable t where
  traverse :: Applicative f => (a -> f b) -> t a -> f (t b)

length :: Foldable t => t a -> Int
length xs = foldl (\n _ -> n + 1) 0 xs

sum :: (Foldable t, Num a) => t a -> a
sum xs = foldl (+) 0 xs

product :: (Foldable t, Num a) => t a -> a
product xs = foldl (*) 1 xs

elem :: (Foldable t, Eq a) => a -> t a -> Bool
elem x xs = any (\y -> y == x) xs

notElem :: (Foldable t, Eq a) => a -> t a -> Bool
notElem x xs = not (elem x xs)

and :: Foldable t => t Bool -> Bool
and xs = foldr (&&) True xs

or :: Foldable t => t Bool -> Bool
or xs = foldr (||) False xs

any :: Foldable t => (a -> Bool) -> t a -> Bool
any p xs = foldr (\x rest -> p x || rest) False xs

all :: Foldable t => (a -> Bool) -> t a -> Bool
all p xs = foldr (\x rest -> p x && rest) True xs

maximum :: (Foldable t, Ord a) => t a -> Maybe a
maximum xs = foldl (\acc x -> Just (maybe x (\m -> max m x) acc)) Nothing xs

minimum :: (Foldable t, Ord a) => t a -> Maybe a
minimum xs = foldl (\acc x -> Just (maybe x (\m -> min m x) acc)) Nothing xs

find :: Foldable t => (a -> Bool) -> t a -> Maybe a
find p xs = foldr (\x rest -> if p x then Just x else rest) Nothing xs

concat :: Foldable t => t [a] -> [a]
concat xss = foldr (\xs rest -> xs ++ rest) [] xss

concatMap :: Foldable t => (a -> [b]) -> t a -> [b]
concatMap g xs = foldr (\x rest -> g x ++ rest) [] xs

traverse_ :: (Foldable t, Applicative f) => (a -> f b) -> t a -> f ()
traverse_ g xs = foldr (\x rest -> g x *> rest) (pure ()) xs

for_ :: (Foldable t, Applicative f) => t a -> (a -> f b) -> f ()
for_ xs g = traverse_ g xs

sequenceA_ :: (Foldable t, Applicative f) => t (f a) -> f ()
sequenceA_ xs = foldr (\m rest -> m *> rest) (pure ()) xs

-- The monadic versions keep the rest of the loop inside a continuation,
-- so it is only built as it runs: long loops stay flat in any monad whose
-- >>= is (IO, and transformers over it).
mapM_ :: (Foldable t, Monad m) => (a -> m b) -> t a -> m ()
mapM_ g xs = foldr (\x rest -> g x >>= \_ -> rest) (pure ()) xs

forM_ :: (Foldable t, Monad m) => t a -> (a -> m b) -> m ()
forM_ xs g = mapM_ g xs

sequence_ :: (Foldable t, Monad m) => t (m a) -> m ()
sequence_ xs = mapM_ id xs

sequenceA :: (Traversable t, Applicative f) => t (f a) -> f (t a)
sequenceA xs = traverse id xs

mapM :: (Traversable t, Applicative f) => (a -> f b) -> t a -> f (t b)
mapM g xs = traverse g xs

forM :: (Traversable t, Applicative f) => t a -> (a -> f b) -> f (t b)
forM xs g = traverse g xs

sequence :: (Traversable t, Applicative f) => t (f a) -> f (t a)
sequence xs = traverse id xs

instance Foldable [] where
  foldr g z xs = listFoldr g z xs
  foldl g z xs = listFoldl g z xs
  toList xs = xs
  -- without the suspension of the rest that foldr would make
  null [] = True
  null _ = False

instance Foldable Maybe where
  foldr _ z Nothing = z
  foldr g z (Just x) = g x z
  foldl _ z Nothing = z
  foldl g z (Just x) = g z x

instance Traversable [] where
  traverse g xs = listFoldr (\x rest -> liftA2 (\y ys -> y : ys) (g x) rest) (pure []) xs

instance Traversable Maybe where
  traverse _ Nothing = pure Nothing
  traverse g (Just x) = fmap Just (g x)

-- Lists ------------------------------------------------------------------------

listFoldr :: (a -> Lazy b -> b) -> b -> [a] -> b
listFoldr _ z [] = z
listFoldr g z (x:xs) = g x (listFoldr g z xs)

listFoldl :: (b -> a -> b) -> b -> [a] -> b
listFoldl _ acc [] = acc
listFoldl g acc (x:xs) = listFoldl g (g acc x) xs

head :: [a] -> Maybe a
head (x:_) = Just x
head [] = Nothing

tail :: [a] -> Maybe [a]
tail (_:xs) = Just xs
tail [] = Nothing

-- What ++ means on lists. The second list is only demanded once the first runs out.
append :: [a] -> Lazy [a] -> [a]
append [] ys = ys
-- A cell already known to be the last is followed by ys itself, with no
-- suspension of append [] ys in between: [x] ++ ys is one cell.
append (x:xs) ys = if primNilNow xs then x : ys else x : append xs ys

map :: (a -> b) -> [a] -> [b]
map _ [] = []
map g (x:xs) = g x : map g xs

filter :: (a -> Bool) -> [a] -> [a]
filter _ [] = []
filter p (x:xs)
  | p x = x : filter p xs
  | otherwise = filter p xs

reverse :: [a] -> [a]
reverse xs = listFoldl (\acc x -> x : acc) [] xs

take :: Int -> [a] -> [a]
take n xs
  | n <= 0 = []
  | otherwise = case xs of
      [] -> []
      (y:ys) -> y : take (n - 1) ys

drop :: Int -> [a] -> [a]
drop n xs
  | n <= 0 = xs
  | otherwise = case xs of
      [] -> []
      (_:ys) -> drop (n - 1) ys

splitAt :: Int -> [a] -> ([a], [a])
splitAt n xs = (take n xs, drop n xs)

takeWhile :: (a -> Bool) -> [a] -> [a]
takeWhile _ [] = []
takeWhile p (x:xs)
  | p x = x : takeWhile p xs
  | otherwise = []

dropWhile :: (a -> Bool) -> [a] -> [a]
dropWhile _ [] = []
dropWhile p (x:xs)
  | p x = dropWhile p xs
  | otherwise = x : xs

span :: (a -> Bool) -> [a] -> ([a], [a])
span _ [] = ([], [])
span p (x:xs)
  | p x = let (ys, zs) = span p xs in (x : ys, zs)
  | otherwise = ([], x : xs)

break :: (a -> Bool) -> [a] -> ([a], [a])
break p xs = span (not . p) xs

(!!) :: [a] -> Int -> Maybe a
(!!) (x:xs) n = if n == 0 then Just x else xs !! (n - 1)
(!!) [] _ = Nothing

zip :: [a] -> [b] -> [(a, b)]
zip (x:xs) (y:ys) = (x, y) : zip xs ys
zip _ _ = []

zipWith :: (a -> b -> c) -> [a] -> [b] -> [c]
zipWith g (x:xs) (y:ys) = g x y : zipWith g xs ys
zipWith _ _ _ = []

unzip :: [(a, b)] -> ([a], [b])
unzip ps = (map fst ps, map snd ps)

zip3 :: [a] -> [b] -> [c] -> [(a, b, c)]
zip3 (x:xs) (y:ys) (z:zs) = (x, y, z) : zip3 xs ys zs
zip3 _ _ _ = []

zipWith3 :: (a -> b -> c -> d) -> [a] -> [b] -> [c] -> [d]
zipWith3 g (x:xs) (y:ys) (z:zs) = g x y z : zipWith3 g xs ys zs
zipWith3 _ _ _ _ = []

unzip3 :: [(a, b, c)] -> ([a], [b], [c])
unzip3 ts = (map (\(a, _, _) -> a) ts, map (\(_, b, _) -> b) ts, map (\(_, _, c) -> c) ts)

lookup :: Eq a => a -> [(a, b)] -> Maybe b
lookup _ [] = Nothing
lookup k ((k', v):rest) = if k == k' then Just v else lookup k rest

repeat :: a -> [a]
repeat x = x : repeat x

replicate :: Int -> a -> [a]
replicate n x = take n (repeat x)

iterate :: (a -> a) -> a -> [a]
iterate g x = x : iterate g (g x)

cycle :: [a] -> [a]
cycle [] = []
cycle xs = xs ++ cycle xs

last :: [a] -> Maybe a
last [] = Nothing
last [x] = Just x
last (_:xs) = last xs

-- Everything but the last element.
init :: [a] -> Maybe [a]
init [] = Nothing
init xs = Just (dropLast xs)
  where
    dropLast (y:ys@(_:_)) = y : dropLast ys
    dropLast _ = []

scanl :: (b -> a -> b) -> b -> [a] -> [b]
scanl f z xs = z : case xs of
  [] -> []
  y:ys -> scanl f (f z y) ys

scanl1 :: (a -> a -> a) -> [a] -> [a]
scanl1 _ [] = []
scanl1 f (x:xs) = scanl f x xs

scanr :: (a -> b -> b) -> b -> [a] -> [b]
scanr _ z [] = [z]
scanr f z (x:xs) = case scanr f z xs of
  qs@(q:_) -> f x q : qs
  [] -> []

scanr1 :: (a -> a -> a) -> [a] -> [a]
scanr1 _ [] = []
scanr1 _ [x] = [x]
scanr1 f (x:xs) = case scanr1 f xs of
  qs@(q:_) -> f x q : qs
  [] -> []

until :: (a -> Bool) -> (a -> a) -> a -> a
until p f x = if p x then x else until p f (f x)

foreign import go "rt_words" words :: String -> [String]
foreign import go "rt_lines" lines :: String -> [String]

-- Characters -------------------------------------------------------------------

foreign import go "unicode.IsSpace" isSpace :: Char -> Bool
foreign import go "unicode.IsLetter" isAlpha :: Char -> Bool
foreign import go "unicode.IsUpper" isUpper :: Char -> Bool
foreign import go "unicode.IsLower" isLower :: Char -> Bool

isDigit :: Char -> Bool
isDigit c = c >= '0' && c <= '9'

isAlphaNum :: Char -> Bool
isAlphaNum c = isAlpha c || isDigit c

-- Read ---------------------------------------------------------------------------

-- | Values that can be read back from what show prints. readsPrec d reads
-- one at precedence d (11 is an argument of a constructor) from the start of
-- the text, and gives what is left. Unlike Haskell's read, read says Nothing
-- when the text is not a value of the type, instead of failing.
class Read a where
  readsPrec :: Int -> [Char] -> Maybe (a, [Char])

read :: Read a => String -> Maybe a
read s = case readsPrec 0 (unpack s) of
  Just (x, rest) | all isSpace rest -> Just x
  _ -> Nothing

-- | The next token, Haskell style, after any spaces: a name, a number, a
-- string or character literal, a parenthesis or bracket, or an operator.
lexToken :: [Char] -> Maybe ([Char], [Char])
lexToken s = case dropWhile isSpace s of
    [] -> Nothing
    c : rest
      | c == '"' -> quoted '"' [c] rest
      | c == '\'' -> quoted '\'' [c] rest
      | isDigit c -> Just (lexNumber (c : rest))
      | isAlpha c || c == '_' -> Just (span (\x -> isAlphaNum x || x == '_' || x == '\'') (c : rest))
      | elem c ['(', ')', '[', ']', '{', '}', ','] -> Just ([c], rest)
      | isSymbol c -> Just (span isSymbol (c : rest))
      | otherwise -> Nothing
  where
    isSymbol x = elem x (unpack "!#$%&*+./<=>?@\\^|-~:")
    -- up to the closing quote, skipping escaped characters
    quoted q acc rest = case rest of
      [] -> Nothing
      '\\' : x : more -> quoted q (x : '\\' : acc) more
      x : more
        | x == q -> Just (reverse (x : acc), more)
        | otherwise -> quoted q (x : acc) more

-- digits, then maybe a fraction, then maybe an exponent
lexNumber :: [Char] -> ([Char], [Char])
lexNumber s =
  let (int, r1) = span isDigit s
      (frac, r2) = case r1 of
        '.' : d : more | isDigit d -> let (ds, r) = span isDigit (d : more) in ('.' : ds, r)
        _ -> ([], r1)
      (ex, r3) = case r2 of
        e : more | e == 'e' || e == 'E' ->
          let (sign, r) = case more of
                x : rest | x == '+' || x == '-' -> ([x], rest)
                _ -> ([], more)
              (ds, r') = span isDigit r
           in if null ds then ([], r2) else (e : sign ++ ds, r')
        _ -> ([], r2)
   in (int ++ frac ++ ex, r3)

-- | The text after the token t, if t comes next.
expectToken :: String -> [Char] -> Maybe [Char]
expectToken t s = case lexToken s of
  Just (t', rest) | pack t' == t -> Just rest
  _ -> Nothing

-- | A reader that also takes its value in parentheses, at any precedence.
readParens :: (Int -> [Char] -> Maybe (a, [Char])) -> Int -> [Char] -> Maybe (a, [Char])
readParens p d s = p d s <|> inParens
  where
    inParens = do
      r1 <- expectToken "(" s
      (x, r2) <- readParens p 0 r1
      r3 <- expectToken ")" r2
      pure (x, r3)

-- | A number with an optional sign; a negative one only where show would
-- leave it without parentheses.
readSigned :: (String -> Maybe a) -> Int -> [Char] -> Maybe (a, [Char])
readSigned number d s = case lexToken s of
    Just (t, rest)
      | t == ['-'] -> if d > 6 then Nothing else unsigned "-" rest
      | t == ['+'] -> unsigned "+" rest
    _ -> unsigned "" s
  where
    unsigned sign r = do
      (t, rest) <- lexToken r
      x <- number (sign ++ pack t)
      pure (x, rest)

foreign import go "strconv.Atoi" goAtoi :: String -> Either String Int
foreign import go "strconv.ParseFloat" goParseFloat :: String -> Int -> Either String Double
foreign import go "strconv.Unquote" goUnquote :: String -> Either String String

fromRight :: Either e a -> Maybe a
fromRight (Right x) = Just x
fromRight (Left _) = Nothing

instance Read Int where
  readsPrec = readParens (readSigned (\t -> fromRight (goAtoi t)))

instance Read Integer where
  readsPrec = readParens (readSigned (\t -> fromRight (integerParse t)))

instance Read Double where
  readsPrec = readParens (readSigned (\t -> fromRight (goParseFloat t 64)))

instance Read Char where
  readsPrec = readParens (\_ s -> do
    (t, rest) <- lexToken s
    c <- case t of
      '\'' : _ -> fromRight (goUnquote (pack t))
      _ -> Nothing
    case unpack c of
      [x] -> Just (x, rest)
      _ -> Nothing)

instance Read String where
  readsPrec = readParens (\_ s -> do
    (t, rest) <- lexToken s
    str <- case t of
      '"' : _ -> fromRight (goUnquote (pack t))
      _ -> Nothing
    pure (str, rest))

instance Read Bool where
  readsPrec = readParens (\_ s -> readConstant "False" False s <|> readConstant "True" True s)

instance Read () where
  readsPrec _ s = do
    r <- expectToken "(" s
    r' <- expectToken ")" r
    pure ((), r')

instance Read a => Read [a] where
  readsPrec = readParens (\_ s -> do
    r <- expectToken "[" s
    case expectToken "]" r of
      Just r' -> pure ([], r')
      Nothing -> do
        (x, r1) <- readsPrec 0 r
        readItems [x] r1)

-- the rest of a list, after its first element
readItems :: Read a => [a] -> [Char] -> Maybe ([a], [Char])
readItems acc r = case expectToken "]" r of
  Just r' -> pure (reverse acc, r')
  Nothing -> do
    r1 <- expectToken "," r
    (x, r2) <- readsPrec 0 r1
    readItems (x : acc) r2

-- Helpers for derived Read instances

-- a constructor's name: Just, or (:|) for an operator
readConstant :: String -> a -> [Char] -> Maybe (a, [Char])
readConstant name x s = fmap (\r -> (x, r)) (case unpack name of
  '(' : op -> expectToken "(" s >>= expectToken (pack (reverse (drop 1 (reverse op)))) >>= expectToken ")"
  _ -> expectToken name s)

-- | The constructor's name, at a precedence where an application needs no
-- parentheses.
readApply :: String -> a -> Int -> [Char] -> Maybe (a, [Char])
readApply name k d s = if d > 10 then Nothing else readConstant name k s

readArg :: Read a => Maybe (a -> b, [Char]) -> Maybe (b, [Char])
readArg m = do
  (f, s) <- m
  (x, rest) <- readsPrec 11 s
  pure (f x, rest)

-- | C {, as show prints a record.
readRecord :: String -> a -> Int -> [Char] -> Maybe (a, [Char])
readRecord name k d s = if d > 10 then Nothing else readConstant name k s >>= \(k', r) -> fmap (\r' -> (k', r')) (expectToken "{" r)

-- | field = value, after a comma unless it is the first.
readField :: Read a => String -> Bool -> Maybe (a -> b, [Char]) -> Maybe (b, [Char])
readField name first m = do
  (f, s) <- m
  r1 <- if first then Just s else expectToken "," s
  r2 <- expectToken name r1
  r3 <- expectToken "=" r2
  (x, rest) <- readsPrec 0 r3
  pure (f x, rest)

readClose :: Maybe (a, [Char]) -> Maybe (a, [Char])
readClose m = do
  (x, s) <- m
  r <- expectToken "}" s
  pure (x, r)

-- Enum and Bounded --------------------------------------------------------------

-- | Values that can be counted, and so used in ranges: [a ..], [a, b ..],
-- [a .. c], [a, b .. c]. Unlike Haskell's, every method is total: toEnum,
-- succ and pred give Nothing past the ends, so a range of a bounded type
-- stops at its last value. Double is not an Enum, because a range of
-- floating-point numbers is not exact; map over a range of Int instead.
class Enum a where
  fromEnum :: a -> Int
  toEnum :: Int -> Maybe a
  succ :: a -> Maybe a
  pred :: a -> Maybe a
  enumFrom :: a -> [a]
  enumFromThen :: a -> a -> [a]
  enumFromTo :: a -> a -> [a]
  enumFromThenTo :: a -> a -> a -> [a]
  succ x = toEnum (fromEnum x + 1)
  pred x = toEnum (fromEnum x - 1)
  enumFrom x = justs (map toEnum (intsFrom (fromEnum x) 1))
  enumFromThen x y = justs (map toEnum (intsFrom (fromEnum x) (fromEnum y - fromEnum x)))
  enumFromTo x y = justs (map toEnum (intsTo (fromEnum x) 1 (fromEnum y)))
  enumFromThenTo x y z = justs (map toEnum (intsTo (fromEnum x) (fromEnum y - fromEnum x) (fromEnum z)))

class Bounded a where
  minBound :: a
  maxBound :: a

-- the values up to the first Nothing
justs :: [Maybe a] -> [a]
justs (Just x : rest) = x : justs rest
justs _ = []

-- n, n + step, ... while not past the limit, without overflowing
intsTo :: Int -> Int -> Int -> [Int]
intsTo n step limit
  | step >= 0 = if n > limit then [] else n : (if n > maxBound - step then [] else intsTo (n + step) step limit)
  | otherwise = if n < limit then [] else n : (if n < minBound - step then [] else intsTo (n + step) step limit)

intsFrom :: Int -> Int -> [Int]
intsFrom n step = intsTo n step (if step >= 0 then maxBound else minBound)

instance Enum Int where
  fromEnum n = n
  toEnum n = Just n
  succ n = if n == maxBound then Nothing else Just (n + 1)
  pred n = if n == minBound then Nothing else Just (n - 1)
  enumFrom n = intsFrom n 1
  enumFromThen n m = intsFrom n (m - n)
  enumFromTo n m = intsTo n 1 m
  enumFromThenTo n m k = intsTo n (m - n) k

instance Enum Integer where
  fromEnum n = toInt n
  toEnum n = Just (integerFromInt n)
  succ n = Just (n + 1)
  pred n = Just (n - 1)
  enumFrom n = integersFrom n 1
  enumFromThen n m = integersFrom n (m - n)
  enumFromTo n m = integersTo n 1 m
  enumFromThenTo n m k = integersTo n (m - n) k

integersFrom :: Integer -> Integer -> [Integer]
integersFrom n step = n : integersFrom (n + step) step

integersTo :: Integer -> Integer -> Integer -> [Integer]
integersTo n step limit
  | step >= 0 = if n > limit then [] else n : integersTo (n + step) step limit
  | otherwise = if n < limit then [] else n : integersTo (n + step) step limit

instance Bounded Int where
  minBound = negate 9223372036854775807 - 1
  maxBound = 9223372036854775807

instance Enum Char where
  fromEnum c = ord c
  toEnum n = if n >= 0 && n <= 1114111 then Just (chr n) else Nothing

instance Bounded Char where
  minBound = chr 0
  maxBound = chr 1114111

instance Enum Bool where
  fromEnum False = 0
  fromEnum True = 1
  toEnum 0 = Just False
  toEnum 1 = Just True
  toEnum _ = Nothing

instance Bounded Bool where
  minBound = False
  maxBound = True

instance Enum () where
  fromEnum () = 0
  toEnum 0 = Just ()
  toEnum _ = Nothing

instance Bounded () where
  minBound = ()
  maxBound = ()

unwords :: [String] -> String
unwords [] = ""
unwords [w] = w
unwords (w:ws) = w ++ " " ++ unwords ws

unlines :: [String] -> String
unlines [] = ""
unlines (l:ls) = l ++ "\n" ++ unlines ls

-- IO -----------------------------------------------------------------------------

print :: Show a => a -> IO ()
print x = putStrLn (show x)

-- All of standard input.
foreign import go "rt_getContents" getContents :: IO String

-- Reading or writing a file can fail, so the error comes back as a value.
foreign import go "rt_readFile" readFile :: String -> IO (Either String String)
foreign import go "rt_writeFile" writeFile :: String -> String -> IO (Either String ())
foreign import go "rt_appendFile" appendFile :: String -> String -> IO (Either String ())

-- The whole of standard input, given to f, and what f gives printed. The
-- input is read in full first: Hago is strict.
interact :: (String -> String) -> IO ()
interact f = getContents >>= \s -> putStr (f s)
