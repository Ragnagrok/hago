-- The Hago prelude, compiled together with every program.
-- IO and a few operations on the built-in types are primitives; the rest is here.

infixr 9 .
infixr 0 $
infixr 5 ++
infixl 1 >>, >>=
infix 4 ==, /=, <, <=, >, >=
infixl 7 *, `div`, `mod`
infixl 6 +, -
infixr 3 &&
infixr 2 ||
infixl 9 !!

data Maybe a = Nothing | Just a deriving (Eq, Ord, Show)
data Either a b = Left a | Right b deriving (Eq, Ord, Show)
data Ordering = LT | EQ | GT deriving (Eq, Ord, Show)

-- Classes ------------------------------------------------------------------

class Eq a where
  (==), (/=) :: a -> a -> Bool
  x /= y = not (x == y)
  x == y = not (x /= y)

class Eq a => Ord a where
  compare :: a -> a -> Ordering
  (<), (<=), (>), (>=) :: a -> a -> Bool
  max, min :: a -> a -> a
  compare x y = if x == y then EQ else if x <= y then LT else GT
  x < y = case compare x y of
    LT -> True
    _ -> False
  x <= y = case compare x y of
    GT -> False
    _ -> True
  x > y = case compare x y of
    GT -> True
    _ -> False
  x >= y = case compare x y of
    LT -> False
    _ -> True
  max x y = if x <= y then y else x
  min x y = if x <= y then x else y

class Show a where
  show :: a -> String
  showsPrec :: Int -> a -> String
  show x = showsPrec 0 x
  showsPrec _ x = show x

class Num a where
  (+), (-), (*) :: a -> a -> a
  negate, abs, signum :: a -> a
  fromInteger :: Int -> a
  x - y = x + negate y
  negate x = fromInteger 0 - x

class (Num a, Ord a) => Integral a where
  div, mod :: a -> a -> a
  toInt :: a -> Int

class Num a => Fractional a where
  (/) :: a -> a -> a

-- Instances for the built-in types ----------------------------------------------

instance Eq Int where
  x == y = primEq x y
  x /= y = primNeq x y

instance Ord Int where
  x < y = primLt x y
  x <= y = primLe x y
  x > y = primGt x y
  x >= y = primGe x y
  compare x y = if primLt x y then LT else if primEq x y then EQ else GT

instance Show Int where
  show x = primShow x
  showsPrec d x = if d > 6 && x < 0 then "(" ++ primShow x ++ ")" else primShow x

instance Num Int where
  x + y = primAdd x y
  x - y = primSub x y
  x * y = primMul x y
  negate x = primNeg x
  abs x = if x < 0 then primNeg x else x
  signum x = if x < 0 then -1 else if x == 0 then 0 else 1
  fromInteger n = n

instance Integral Int where
  div x y = primDiv x y
  mod x y = primMod x y
  toInt x = x

instance Eq Double where
  x == y = primEq x y
  x /= y = primNeq x y

instance Ord Double where
  x < y = primLt x y
  x <= y = primLe x y
  x > y = primGt x y
  x >= y = primGe x y
  compare x y = if primLt x y then LT else if primEq x y then EQ else GT

instance Show Double where
  show x = primShow x
  showsPrec d x = if d > 6 && x < 0.0 then "(" ++ primShow x ++ ")" else primShow x

instance Num Double where
  x + y = primAdd x y
  x - y = primSub x y
  x * y = primMul x y
  negate x = primNeg x
  abs x = if x < 0.0 then primNeg x else x
  signum x = if x < 0.0 then -1.0 else if x == 0.0 then 0.0 else 1.0
  fromInteger n = primIntToDouble n

instance Fractional Double where
  x / y = primFDiv x y

instance Eq Char where
  x == y = primEq x y
  x /= y = primNeq x y

instance Ord Char where
  x < y = primLt x y
  x <= y = primLe x y
  x > y = primGt x y
  x >= y = primGe x y
  compare x y = if primLt x y then LT else if primEq x y then EQ else GT

instance Show Char where
  show c = primShow c

instance Eq String where
  x == y = primEq x y
  x /= y = primNeq x y

instance Ord String where
  x < y = primLt x y
  x <= y = primLe x y
  x > y = primGt x y
  x >= y = primGe x y
  compare x y = if primLt x y then LT else if primEq x y then EQ else GT

instance Show String where
  show s = primShow s

instance Eq Bool where
  True == True = True
  False == False = True
  _ == _ = False

instance Ord Bool where
  compare False True = LT
  compare True False = GT
  compare _ _ = EQ

instance Show Bool where
  show True = "True"
  show False = "False"

instance Eq () where
  _ == _ = True

instance Ord () where
  compare _ _ = EQ

instance Show () where
  show _ = "()"

instance Eq a => Eq [a] where
  [] == [] = True
  (x:xs) == (y:ys) = x == y && xs == ys
  _ == _ = False

instance Ord a => Ord [a] where
  compare [] [] = EQ
  compare [] _ = LT
  compare _ [] = GT
  compare (x:xs) (y:ys) = thenCmp (compare x y) (compare xs ys)

instance Show a => Show [a] where
  show xs = "[" ++ items xs ++ "]"
    where
      items [] = ""
      items [y] = show y
      items (y:ys) = show y ++ "," ++ items ys

instance (Eq a, Eq b) => Eq (a, b) where
  (a, b) == (c, d) = a == c && b == d

instance (Ord a, Ord b) => Ord (a, b) where
  compare (a, b) (c, d) = thenCmp (compare a c) (compare b d)

instance (Show a, Show b) => Show (a, b) where
  show (a, b) = "(" ++ show a ++ "," ++ show b ++ ")"

instance (Eq a, Eq b, Eq c) => Eq (a, b, c) where
  (a, b, c) == (d, e, f) = a == d && b == e && c == f

instance (Ord a, Ord b, Ord c) => Ord (a, b, c) where
  compare (a, b, c) (d, e, f) = thenCmp (compare a d) (thenCmp (compare b e) (compare c f))

instance (Show a, Show b, Show c) => Show (a, b, c) where
  show (a, b, c) = "(" ++ show a ++ "," ++ show b ++ "," ++ show c ++ ")"

-- Used by derived instances.
thenCmp :: Ordering -> Lazy Ordering -> Ordering
thenCmp EQ o = o
thenCmp o _ = o

showParenString :: Bool -> String -> String
showParenString True s = "(" ++ s ++ ")"
showParenString False s = s

-- Numbers ------------------------------------------------------------------

fromIntegral :: (Integral a, Num b) => a -> b
fromIntegral x = fromInteger (toInt x)

truncate :: Double -> Int
truncate x = primTruncate x

even, odd :: Integral a => a -> Bool
even n = n `mod` 2 == 0
odd n = not (even n)

subtract :: Num a => a -> a -> a
subtract x y = y - x

id :: a -> a
id x = x

const :: a -> b -> a
const x _ = x

flip :: (a -> b -> c) -> b -> a -> c
flip f x y = f y x

(.) :: (b -> c) -> (a -> b) -> a -> c
(.) f g = \x -> f (g x)

($) :: (a -> b) -> a -> b
($) f x = f x

-- The second argument is suspended, so these short-circuit.
(&&) :: Bool -> Lazy Bool -> Bool
True && b = b
False && _ = False

(||) :: Bool -> Lazy Bool -> Bool
True || _ = True
False || b = b

not :: Bool -> Bool
not True = False
not False = True

otherwise :: Bool
otherwise = True

fst :: (a, b) -> a
fst (x, _) = x

snd :: (a, b) -> b
snd (_, y) = y

maybe :: b -> (a -> b) -> Maybe a -> b
maybe d _ Nothing = d
maybe _ f (Just x) = f x

either :: (a -> c) -> (b -> c) -> Either a b -> c
either f _ (Left x) = f x
either _ g (Right y) = g y

-- Lists ------------------------------------------------------------------

head :: [a] -> a
head (x:_) = x
head [] = error "head: empty list"

tail :: [a] -> [a]
tail (_:xs) = xs
tail [] = error "tail: empty list"

null :: [a] -> Bool
null [] = True
null _ = False

-- What ++ means on lists. The second list is only demanded once the first runs out.
append :: [a] -> Lazy [a] -> [a]
append [] ys = ys
append (x:xs) ys = x : append xs ys

map :: (a -> b) -> [a] -> [b]
map _ [] = []
map f (x:xs) = f x : map f xs

filter :: (a -> Bool) -> [a] -> [a]
filter _ [] = []
filter p (x:xs)
  | p x = x : filter p xs
  | otherwise = filter p xs

-- The accumulator is lazy, so foldr can stop early on infinite lists.
foldr :: (a -> Lazy b -> b) -> b -> [a] -> b
foldr _ z [] = z
foldr f z (x:xs) = f x (foldr f z xs)

foldl :: (b -> a -> b) -> b -> [a] -> b
foldl _ acc [] = acc
foldl f acc (x:xs) = foldl f (f acc x) xs

sum :: Num a => [a] -> a
sum xs = foldl (+) 0 xs

product :: Num a => [a] -> a
product xs = foldl (*) 1 xs

length :: [a] -> Int
length xs = foldl (\n _ -> n + 1) 0 xs

reverse :: [a] -> [a]
reverse xs = foldl (\acc x -> x : acc) [] xs

concat :: [[a]] -> [a]
concat xss = foldr (\xs rest -> xs ++ rest) [] xss

concatMap :: (a -> [b]) -> [a] -> [b]
concatMap f xs = concat (map f xs)

and :: [Bool] -> Bool
and xs = foldr (&&) True xs

or :: [Bool] -> Bool
or xs = foldr (||) False xs

any :: (a -> Bool) -> [a] -> Bool
any p xs = or (map p xs)

all :: (a -> Bool) -> [a] -> Bool
all p xs = and (map p xs)

elem :: Eq a => a -> [a] -> Bool
elem x xs = any (\y -> y == x) xs

take :: Int -> [a] -> [a]
take n xs
  | n <= 0 = []
  | otherwise = case xs of
      [] -> []
      (y:ys) -> y : take (n - 1) ys

drop :: Int -> [a] -> [a]
drop n xs
  | n <= 0 = xs
  | otherwise = case xs of
      [] -> []
      (_:ys) -> drop (n - 1) ys

takeWhile :: (a -> Bool) -> [a] -> [a]
takeWhile _ [] = []
takeWhile p (x:xs)
  | p x = x : takeWhile p xs
  | otherwise = []

dropWhile :: (a -> Bool) -> [a] -> [a]
dropWhile _ [] = []
dropWhile p (x:xs)
  | p x = dropWhile p xs
  | otherwise = x : xs

(!!) :: [a] -> Int -> a
(!!) (x:xs) n = if n == 0 then x else xs !! (n - 1)
(!!) [] _ = error "!!: index too large"

zip :: [a] -> [b] -> [(a, b)]
zip (x:xs) (y:ys) = (x, y) : zip xs ys
zip _ _ = []

zipWith :: (a -> b -> c) -> [a] -> [b] -> [c]
zipWith f (x:xs) (y:ys) = f x y : zipWith f xs ys
zipWith _ _ _ = []

lookup :: Eq a => a -> [(a, b)] -> Maybe b
lookup _ [] = Nothing
lookup k ((k', v):rest) = if k == k' then Just v else lookup k rest

repeat :: a -> [a]
repeat x = x : repeat x

replicate :: Int -> a -> [a]
replicate n x = take n (repeat x)

iterate :: (a -> a) -> a -> [a]
iterate f x = x : iterate f (f x)

cycle :: [a] -> [a]
cycle [] = error "cycle: empty list"
cycle xs = xs ++ cycle xs

enumFrom :: Int -> [Int]
enumFrom n = n : enumFrom (n + 1)

enumFromTo :: Int -> Int -> [Int]
enumFromTo a b
  | a > b = []
  | otherwise = a : enumFromTo (a + 1) b

-- IO -----------------------------------------------------------------------

print :: Show a => a -> IO ()
print x = putStrLn (show x)

mapM_ :: (a -> IO ()) -> [a] -> IO ()
mapM_ _ [] = return ()
mapM_ f (x:xs) = do
  f x
  mapM_ f xs

maximum :: Ord a => [a] -> a
maximum (x:xs) = foldl max x xs
maximum [] = error "maximum: empty list"

minimum :: Ord a => [a] -> a
minimum (x:xs) = foldl min x xs
minimum [] = error "minimum: empty list"
